SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=*

# Leave POSTGRES_DB empty to use SQLite in dev. Postgres is required in prod
# (it also stores LangGraph checkpoints so approvals can wait for days).
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 1 = run Celery tasks inline (no Redis needed in dev)
CELERY_EAGER=1
CELERY_BROKER_URL=redis://localhost:6379/0

# console | gmail
EMAIL_PROVIDER=console
GMAIL_TOKEN_FILE=gmail_token.json
GMAIL_SENDER=sales@webfolks.in
# Level 2 (human approves follow-ups) = 0, Level 3 (auto-send) = 1
FOLLOWUP_AUTOSEND=0


TAVILY_API_KEY =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